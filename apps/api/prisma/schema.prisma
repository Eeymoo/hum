generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String?   @unique
  name          String?
  avatar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  apiKeys       ApiKey[]
  records       Record[]
  weights       Weight[]
  exercises     Exercise[]
  diets         Diet[]
  sleeps        Sleep[]
  deleteAt      Int       @default(0)

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String?
  access_token      String?
  refresh_token     String?
  expires_at        Int?
  password          String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  deleteAt          Int     @default(0)

  @@map("accounts")
}

model ApiKey {
  id        String    @id @default(uuid())
  userId    String
  name      String
  key       String    @unique
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deleteAt  Int       @default(0)

  @@map("api_keys")
}

model Record {
  id           String   @id @default(uuid())
  userId       String?
  type         String
  data         String
  tags         String?
  note         String?
  attachments  String?
  date         DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deleteAt     Int      @default(0)
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, date])
  @@index([createdAt])
  @@map("records")
}

model Weight {
  id          String   @id @default(uuid())
  userId      String?
  weight      Float
  bodyFat     Float?
  muscleMass  Float?
  bmi         Float?
  water       Float?
  boneMass    Float?
  visceralFat Int?
  note        String?
  attachments String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deleteAt    Int      @default(0)
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([date])
  @@map("weights")
}

model Exercise {
  id             String   @id @default(uuid())
  userId         String?
  type           String
  duration       Int
  caloriesBurned Int?
  activities     String
  heartRateAvg   Int?
  heartRateMax   Int?
  feeling        Int?
  location       String?
  note           String?
  attachments    String?
  date           DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deleteAt       Int      @default(0)
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([type, date])
  @@map("exercises")
}

model Diet {
  id          String   @id @default(uuid())
  userId      String?
  mealType    String
  calories    Int?
  protein     Float?
  carbs       Float?
  fat         Float?
  fiber       Float?
  sodium      Float?
  foods       String
  water       Int?
  note        String?
  attachments String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deleteAt    Int      @default(0)
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([date])
  @@map("diets")
}

model Sleep {
  id          String   @id @default(uuid())
  userId      String?
  duration    Float
  bedTime     String
  wakeTime    String
  quality     Int
  deepSleep   Float?
  remSleep    Float?
  awakenings  Int?
  feeling     Int?
  note        String?
  attachments String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deleteAt    Int      @default(0)
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([date])
  @@map("sleeps")
}

model DeviceCode {
  id         String    @id @default(uuid())
  deviceCode String    @unique
  userCode   String    @unique
  status     String    @default("pending")
  userId     String?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@map("device_codes")
}

model AccessToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("access_tokens")
}
